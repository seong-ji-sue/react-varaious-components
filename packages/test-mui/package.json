{
  "name": "@jsproject/test-mui",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.js",
  "scripts": {
    "start": "npm run start:esbuild && npm run start:webpack",
    "build": "npm run build:esbuild && npm run build:webpack",
    "run": "npm run run:esbuild && npm run run:webpack",
    "analyze": "npm run analyze:esbuild && npm run analyze:webpack",
    "start:esbuild": "NODE_ENV=development node esbuild.config.js",
    "start:webpack": "NODE_ENV=development webpack serve --config webpack.config.js --mode development",
    "build:esbuild": "NODE_ENV=production node esbuild.config.js",
    "build:webpack": "NODE_ENV=production webpack --config webpack.config.js --mode production",
    "run:esbuild": "NODE_ENV=production node esbuild.config.js && node server.js",
    "run:webpack": "NODE_ENV=production webpack --config webpack.config.js --mode production && node server.js",
    "analyze:esbuild": "ANALYZE=true NODE_ENV=production node esbuild.config.js",
    "analyze:webpack": "ANALYZE=true NODE_ENV=production webpack --config webpack.config.js --mode production"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hookform/error-message": "^2.0.1",
    "@hookform/resolvers": "^3.6.0",
    "@jsproject/common": "^1.0.0",
    "@mui/icons-material": "^6.3.0",
    "@mui/material": "^6.3.0",
    "@mui/x-data-grid": "^7.23.5",
    "dotenv": "^16.4.7",
    "express": "^4.18.2",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "^6.26.0",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "dotenv": "^16.4.7",
    "esbuild": "^0.18.14",
    "esbuild-serve": "^1.0.1",
    "esbuild-visualizer": "^0.7.0"
  }
}
